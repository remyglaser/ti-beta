0967   9BC0             ; c: y coordinate of upper left corner
0968   9BC0             ; d: x coordinate of lower right corner
0969   9BC0             ; e: y coordinate of lower right corner
0970   9BC0             ; h: 0 - pixel off operation
0971   9BC0             ;    1 - pixel on operation
0972   9BC0             ;    2+ - pixel change operation (xor)
0973   9BC0             ; @require b<96 && c<64 && d<96 && e<64 && b<=d && c<=e
