0936   9BAF             ; Compares the program names in op1 and op2, the _cpop1op2 routine compares them as floating point
0937   9BAF             ; Input:
0938   9BAF             ; op1: program name to compare
0939   9BAF             ; op2: program name to compare
0940   9BAF             ; Output:
0941   9BAF             ; zero flag set if op1=op2
0942   9BAF             ; zero flag reset if op1!=op2
0943   9BAF             ; Destroys:
0944   9BAF             ; Registers hl, de, b, a, c
