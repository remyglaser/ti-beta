Scheikunde:
 call _clrLCDFull
 call _homeup
 ld hl,SKMENU
 call _Puts
SK_KEYLOOP:
 call BETAKEY
 cp 64
 jp z,MAIN_MENU
 cp 143
 jp z,SK_SAMENVATTINGEN
 cp 144
 jp z,SK_CALCULATORS
 cp 145
 jp z,SK_PLUGINS
 cp 146
 jp z,MAIN_MENU
 cp 147
 jp z,EXIT
 jr SK_KEYLOOP
SK_SAMENVATTINGEN:
 ld a,%00100100
 ld (iy+extraplugflags),a
 jp BETASHELL
SK_CALCULATORS:
 ld a,%00010100
 ld (iy+extraplugflags),a
 jp BETASHELL
SK_PLUGINS:
 ld a,%00110100
 ld (iy+extraplugflags),a
 jp BETASHELL
SKMENU:
 .db " - Scheikunde - "
 .db "                "
 .db "1:Samenvattingen"
 .db "2:Calculators   "
 .db "3:Plugins       "
 .db "4:Terug         "
 .db "5:Einde",0