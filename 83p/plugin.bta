BETASHELL:
 xor a
 ld (plugin_count),a
 bcall(_grbufclr)
 ld hl,LINE
 ld de,plotsscreen+756
 ld bc,12
 ldir
 bcall(_grbufcpy_v)
 ld h,2

 ld bc,0*256+63
 ld de,94*256+63
 bcall(_iline)

 ld bc,0*256+55
 ld de,94*256+55
 bcall(_iline)

 ld bc,0*256+63
 ld de,0*256+1
 bcall(_iline)

 ld bc,94*256+63
 ld de,94*256+1
 bcall(_iline)

 ld bc,10*256+63
 ld de,10*256+55
 bcall(_iline)





 ld hl,1*256+21
 ld (pencol),hl
 ld hl,MENUTITLE
 bcall(_vputs)







 ld hl,(progptr)
 inc hl
MAIN:
 dec hl
 ld a,(hl) 
 cp 1
 jp z,SKIP
 cp 5
 jp z,PROGRAM
 cp 6
 jp z,PROGRAM




			; By now, the plugin adress list should be complete


 ld a,(plugin_count)
 cp 0
 jp nz,MORE_THAN_ONE
 ld hl,29*256+26
 ld (pencol),hl
 ld hl,NONEFOUNDTXT1
 bcall(_vputs)
 ld hl,35*256+17
 ld (pencol),hl
 ld hl,NONEFOUNDTXT2
 bcall(_vputs)
 call BETAKEY
 jp MAIN_MENU
MORE_THAN_ONE:
 ld b,a			; a is the total number of plugins
 ld de,PLUGIN_LIST-6
INC_LOOP3:		; This sets de to the beginning of the data of the last plugin
 push bc
 ld b,6
INC__LOOP3:
 inc de
 djnz INC__LOOP3
 pop bc
 djnz INC_LOOP3

 inc de
 inc de			 ;2 incs to set de to the first name pointer
 ld (dsave),de
 ld b,a
LIST_LOOP:
 ld a,b
 cp 0
 jp z,END_OF_LIST_LOOP
 ld (ASAVE),a
 push bc
 add a,246
 jp c,CHECK18
 ld c,247
 sub c
 jp c,CHECK18
 ld a,6
 set digitnumber,(iy+plugflags)
 ld c,0
CHECKROW:
 ld (pencol),a
 ld a,(ASAVE)
 ld b,a
 ld a,3
 sub c
MINILOOP:
 add a,6
 djnz MINILOOP
 ld (penrow),a
 bit digitnumber,(iy+plugflags)
 jp z,TWODIGITS
 ld a,(asave)
 add a,48
 bcall(_vputmap)
OUTPUT_COLON:
 ld a,$3a
 bcall(_vputmap)
 ld de,(dsave)
 ld a,(de)
 ld l,a
 inc de
 ld a,(de)
 ld h,a



 ld b,7
DEC_LOOP:
 dec de
 djnz DEC_LOOP

 ld (dsave),de
BPUTPS:
 ld a,(hl)
 ld b,a
BPUTPSLOOP:
 dec hl
 ld a,(hl)
 bcall(_vputmap)
 djnz BPUTPSLOOP





 pop bc
END_OF_LIST_LOOP:
 djnz LIST_LOOP



 res digit1,(iy+plugflags)
 res digit2,(iy+plugflags)
PLUGIN_KEYLOOP:
 call BETAKEY
 cp 64
 jp z,MAIN_MENU
 cp 2
 jp z,BACKSPACE
 cp 5
 jp z,ENTER_PRESSED
 ld b,142
 sub b
 push af
 jp c,PLUGIN_KEYLOOP
 add a,246
 jp c,PLUGIN_KEYLOOP
 ld b,198
 sub b
 bit digit2,(iy+plugflags)
 jp nz,plugin_keyloop
 bit digit1,(iy+plugflags)
 jp nz,SECONDDIGIT
 ld hl,1*256+2
 ld (pencol),hl
 bcall(_vputmap)
 pop af
 ld (typein1stdigit),a
 set digit1,(iy+plugflags)
 jp PLUGIN_KEYLOOP
SECONDDIGIT:
 ld hl,1*256+6
 ld (pencol),hl
 bcall(_vputmap)
 pop af
 ld (typein2nddigit),a
 set digit2,(iy+plugflags)
 jp PLUGIN_KEYLOOP
BACKSPACE:
 bit digit2,(iy+plugflags)
 jp nz,BACKSPACESECOND
 bit digit1,(iy+plugflags)
 jp z,PLUGIN_KEYLOOP
 ld hl,1*256+2
 ld (pencol),hl
 ld hl,EMPTYSPACE
 bcall(_vputs)
 res digit1,(iy+plugflags)
 jp PLUGIN_KEYLOOP
BACKSPACESECOND:
 ld hl,1+256+5
 ld (pencol),hl
 ld hl,EMPTYSPACE
 bcall(_vputs)
 res digit2,(iy+plugflags)
 jp PLUGIN_KEYLOOP
ENTER_PRESSED:
 bit digit2,(iy+plugflags)
 jp nz,TWODIGITCHECK
 bit digit1,(iy+plugflags)
 jp z,PLUGIN_KEYLOOP
 ld a,(typein1stdigit)
 jp CHECK_VALID
TWODIGITCHECK:
 ld a,(typein1stdigit)
 cp 1
 jp nz,PLUGIN_KEYLOOP
 ld a,(typein2nddigit)
 add a,10
CHECK_VALID:
 cp 0
 jp z,plugin_keyloop
 ld (asave),a
 ld a,(plugin_count)
 ld b,a
 ld a,255
 sub b
 ld b,a
 ld a,(asave)
 add a,b
 jp c,plugin_keyloop
 sub b


			; a is the number of the plugin

 ld hl,plugin_list-6
 ld b,a
INC_LOOP4:
 push bc
 ld b,6
INC__LOOP4:
 inc hl
 djnz INC__LOOP4
 pop bc
 djnz INC_LOOP4

 ld de,CURRENT_PLUGIN
 ld bc,6
 ldir			; The plugin settings are now in current_plugin



 ld a,(current_flags)
 bit PlugText,a
 jp nz,SIMPLE_SCROLL

 bit PlugBasic,a
 jr nz,BASIC_PLUG

 jp BETASHELL

BASIC_PLUG:
 ld de,op7
 call TRANSFORM
 ld hl,op7
 call EXECBASIC
 jp BETASHELL






OP7:
 .db 5,0,0,0,0,0,0,0,0,0

TRANSFORM:
 ld hl,(current_name)
 ld a,(hl)
 ld b,a
TRANSFORM_LOOP:
 dec hl
 inc de
 ld a,(hl)
 ld (de),a
 djnz TRANSFORM_LOOP
 ret




SIMPLE_SCROLL:
 ld hl,(current_adress)
 ld (hsave),hl
output_page:
 ld a,(hl)
 cp $D4
 jp z,PAGE_FULL
 ld (hsave),hl
 bcall(_grbufclr)
 bcall(_grbufcpy_v)
 ld a,2
 ld (penrow),a
 xor a
 ld (pencol),a
 ld hl,(hsave)
 ld a,(hl)
 dec hl
OUTPUT_page_LOOP:
 inc hl
 ld a,(hl)
 cp $3F
 jp z,NEXT_LINE
 cp $D4
 jp z,PAGE_FULL
 push hl

 cp 4
 jp z,STO
 cp 6
 jp z,SQUARBRACKL
 cp 7
 jp z,SQUARBRACKR
 cp 8
 jp z,ACCOLADEL
 cp 9
 jp z,ACCOLADER
 cp 12
 jp z,SUPERSCRIPTSIGN
 cp 13
 jp z,SUPERSCRIPTSIGN
 cp 15
 jp z,SUPER3
 cp 16
 jp z,BRACKET
 cp 17
 jp z,BRACKET
 cp 41
 jp z,SPACE
 cp 43
 jp z,COMMA
 cp 45
 jp z,FACULTY
 cp 58
 jp z,DOT
 cp 59
 jp z,EE
 cp 62
 jp z,COLON
 cp 106
 jp z,GELIJK
 cp 107
 jp z,KLEINER
 cp 108
 jp z,GROTER
 cp 109
 jp z,KLEINEROFGELIJK
 cp 110
 jp z,GROTEROFGELIJK
 cp 111
 jp z,NIET
 cp 112
 jp z,PLUS
 cp 113
 jp z,MINUS
 cp 130
 jp z,MULT
 cp 131
 jp z,DIV
 cp 174
 jp z,APOSTROF
 cp 175
 jp z,QUESTIONMARK
 cp 240
 jp z,MACHT
 cp 172
 jp z,PI
 cp 188
 jp z,WORTEL
 cp 241
 jp nz,OTHER
XWORTEL:
 ld a,205
 bcall(_vputmap)
 ld a,16
 jp vputmapspecial
STO:
 ld a,28
 jp OTHER
SUPER3:
 dec a
 jp OTHER
SQUARBRACKL:
 ld a,193
 jp OTHER
SQUARBRACKR:
 ld a,93
 jp OTHER
ACCOLADEL:
 ld a,123
 jp OTHER
ACCOLADER:
 ld a,125
 jp OTHER
SUPERSCRIPTSIGN:
 add a,5
 jp OTHER
BRACKET:
 add a,24
 jp OTHER
SPACE:
 ld a,32
 jp OTHER
COMMA:
 ld a,44
 jp OTHER
FACULTY:
 ld a,33
 jp OTHER
DOT:
 ld a,46
 jp OTHER
EE:
 ld a,27
 jp OTHER
COLON:
 ld a,':'
 jp OTHER
GELIJK:
 ld a,61
 jp OTHER
KLEINER:
 ld a,60
 jp OTHER
GROTER:
 ld a,62
 jp OTHER
KLEINEROFGELIJK:
 ld a,23
 jp OTHER
GROTEROFGELIJK:
 ld a,25
 jp OTHER
NIET:
 ld a,24
 jp OTHER
PLUS:
 ld a,43
 jp OTHER
MINUS:
 ld a,45
 jp OTHER
MULT:
 ld a,42
 jp OTHER
DIV:
 ld a,47
 jp OTHER
APOSTROF:
 ld a,39
 jp OTHER
QUESTIONMARK:
 ld a,63
 jp OTHER
MACHT:
 ld a,94
 jp OTHER
PI:
 ld a,196
 jp OTHER
WORTEL:
 ld a,16
 bcall(_vputmap)
 ld a,40
 jp vputmapspecial
OTHER:
 bcall(_vputmap)
 pop hl
 jp OUTPUT_page_loop
vputmapspecial:
 pop hl
 ex af,af'
 ld a,(pencol)
 add a,163
 jp c,NEXT_LINE
 ld a,(hl)
 cp $3F
 jp z,NEXT_LINE
 cp $D4
 jp z,PAGE_FULL
 ex af,af'
 push hl
 jp OTHER
NEXT_LINE:
 ld a,(penrow)
 add a,6
 cp 62
 jp z,PAGE_FULL
 ld (penrow),a
 xor a
 ld (pencol),a
 jp OUTPUT_page_loop
PAGE_FULL:
 call BETAKEY
 cp 64
 jp z,BETASHELL
 cp 4
 jp z,DOWN
 cp 5
 jp z,BETASHELL
 cp 3
 jp nz,PAGE_FULL
UP:
 ld hl,(hsave)
 dec hl
 dec hl
 ld a,(hl)
 cp $d9
 jp z,PAGE_FULL
 cp $D5
 jp z,PAGE_Full
 ld hl,(hsave)
 ld b,11
UP_LOOP:
 dec hl
 ld a,(hl)
 cp $3F
 jp nz,UP_LOOP
 djnz UP_LOOP
 inc hl
 jp output_page
DOWN:
 ld hl,(hsave)
 ld b,10
DOWN_LOOP:
 inc hl
 ld a,(hl)
 cp $D4
 jp z,PAGE_FULL
 cp $3F
 jp nz,DOWN_LOOP
 djnz DOWN_LOOP
 inc hl
 jp output_page









CHECK18:
 res digitnumber,(iy+plugflags)
 ld a,48
 ld c,54
 jp CHECKROW
TWODIGITS:
 ld a,$31
 bcall(_vputmap)
 ld a,(asave)
 add a,38
 bcall(_vputmap)
 jp OUTPUT_COLON








PROGRAM:

 push hl			; Saves adress in symbol table

;; Following code is for TI-83+ ONLY
; 
; 
; 
; dec hl			; T2 (not important)
; dec hl			; Ver (not important)
; dec hl			; DAL (Low byte of prog adress)
; ld e,(hl)
; dec hl			; DAH (High byte of prog adress)
; ld d,(hl)
; dec hl			; Page (Must be zero because the program is not allowed to be archived)
;; ld a,(hl)
; dec hl			; NL (Length of name)
;; and a
;; jr nz,MAIN
; 
; 
; 
;; End





; Following code is for TI-83 ONLY
 
 
 
 dec hl			; DAL (Low byte of prog adress)
 ld e,(hl)
 dec hl			; DAH (High byte of prog adress)
 ld d,(hl)
 dec hl			; NL (Length of name)
 
 
 
; End



 ex de,hl		; hl now contains the adress of the plugin itself
 inc hl
 inc hl

 exx
 ld hl,current_plugin
 ld b,6
CLEAR_LOOP:
 xor a
 ld (hl),a
 inc hl
 djnz CLEAR_LOOP
 exx

 ld a,(hl)
 cp $D9
 jp z,OLDTEXTPLUGIN
 cp $3F
 jp z,BASICPLUGIN
 jp INVALID

CHECKQ:

 inc hl
 ld a,(hl)
 cp $51
 jp nz,INVALID

 inc hl
 ld a,(hl)
 ld b,48
 sub b
 jp c,DECRET
 add a,248
 jp z,DECRET
 ld b,200
 sub b
 ld (current_q),a
 ret

CHECKSUBJECT:
 inc hl
 ld a,(hl)
 cp $29
 jr z,SU_NO_OK
 cp 'W'
 jr z,SU_WI
 cp 'N'
 jr z,SU_NA
 cp 'S'
 jr z,SU_SK
 cp 'B'
 jr z,SU_BI
 jp DECRET
SU_WI:
 inc hl
 ld a,(hl)
 cp 'I'
 jr z,SU_WI_OK
 jp DECRET
SU_NA:
 inc hl
 ld a,(hl)
 cp 'A'
 jr z,SU_NA_OK
 jp DECRET
SU_SK:
 inc hl
 ld a,(hl)
 cp 'K'
 jr z,SU_SK_OK
 jp DECRET
SU_BI:
 inc hl
 ld a,(hl)
 cp 'I'
 jr z,SU_BI_OK
DECRET:
 pop hl
 ld hl,INVALID
 push hl
 ret
SU_WI_OK:
 bit XWiskunde,(iy+extraplugflags)
 ret nz
 jp DECRET
SU_NA_OK:
 bit XNatuurkunde,(iy+extraplugflags)
 ret nz
 jp DECRET
SU_SK_OK:
 bit XScheikunde,(iy+extraplugflags)
 ret nz
 jp DECRET
SU_BI_OK:
 bit XBiologie,(iy+extraplugflags)
 ret nz
 jp DECRET
SU_NO_OK:
 bit XNoSubject,(iy+extraplugflags)
 ret nz
 jp DECRET
OLDTEXTPLUGIN:
 bit XSumm,(iy+extraplugflags)
 jp z,INVALID

 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 inc hl
 ld a,(hl)
 cp $2A
 jp nz,INVALID

 call CHECKQ


 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 inc hl
 ld a,(hl)
 cp $2A
 jp nz,INVALID

 call CHECKSUBJECT


 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 inc hl
 ld a,(hl)
 cp $D9
 jp nz,INVALID

 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 ld a,(current_flags)
 set PlugText,a
 ld (current_Flags),a
 jp VALID


BASICPLUGIN:
 bit XCalc,(iy+ExtraPlugFlags)
 jp z,INVALID

 inc hl
 ld a,(hl)
 cp $2A
 jp nz,INVALID

 call CHECKQ


 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 inc hl
 ld a,(hl)
 cp $2A
 jp nz,INVALID

 call CHECKSUBJECT


 inc hl
 ld a,(hl)
 cp $3F
 jp nz,INVALID

 ld a,(current_flags)
 set PlugBasic,a
 ld (current_flags),a
VALID:
 ld a,(PLUGIN_COUNT)
 cp 18			; See if the maximum is exceeded
 jp z,INVALID
 inc a			; Now we have a valid plugin
 ld (Plugin_Count),a	; Update plugin count
 inc hl			; hl is at the actual beginning of the plugin
 ld (current_adress),hl
 pop hl
 push hl
 ld b,3		; This code is for TI-83 ONLY
; ld b,6			; This code is for TI-83+ ONLY
NAME_LOOP:
 dec hl
 djnz NAME_LOOP

 ld (current_name),hl

 ld de,plugin_list-6
 ld b,a
INC__LOOP2:
 push bc
 ld b,6
INC_LOOP2:
 inc de
 djnz INC_LOOP2
 pop bc
 djnz INC__LOOP2
 ld hl,CURRENT_PLUGIN
 ld bc,6
 ldir



INVALID:
 pop hl
SKIP:
 ld b,3		; This code is for TI-83 ONLY
; ld b,6			; This code is for TI-83+ ONLY
SKIP2:
 dec hl
 djnz SKIP2
 ld b,(hl)
SKIP3:
 dec hl
 djnz SKIP3
 jp MAIN











CURRENT_PLUGIN:
CURRENT_Q:
 .db 0
CURRENT_FLAGS:
 .db 0
CURRENT_NAME:
 .db 0,0
CURRENT_ADRESS:
 .db 0,0









PROGADR:
 .db 0,0
MENUTITLE:
 .db "-Beta  Plugins-",0
NONEFOUNDTXT1:
 .db "Er zijn geen",0
NONEFOUNDTXT2:
 .db "Plugins gevonden",0
LINE:
 .db %01111111,255,255,255,255,255,255,255,255,255,255,%11111100
Typein1stDigit:
 .db 0
Typein2ndDigit:
 .db 0
EMPTYSPACE:
 .db "   ",0